    "t2.zipcode < $float",
    "t2.zipcode <= $float",
    "t2.zipcode = $float",
    "t2.zipcode > $float",
    "t2.zipcode >= $float",
    "t2.zipcode IS NOT NULL",
    "t2.zipcode IS NULL"
  ]
}